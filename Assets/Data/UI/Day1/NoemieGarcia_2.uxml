    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue de GuichetClair" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Application React et TypeScript de prise de rendez-vous.&#10;&#10;Les tests couvrent validation, messages d’erreur, navigation au clavier et remplacement de requêtes lentes. Le chargement précédent est annulé ou ignoré lorsque les filtres changent.&#10;&#10;Les données de démonstration sont fictives. Le dépôt fournit les commandes de démarrage et une liste explicite des vérifications d’accessibilité." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
