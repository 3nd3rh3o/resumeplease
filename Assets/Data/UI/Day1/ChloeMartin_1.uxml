    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence Vitrine Express" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Chloé Martin a participé à la mise à jour de sites vitrines de 2022 à 2024.&#10;&#10;Les sites utilisaient un constructeur de pages. Elle adaptait les textes, les couleurs et les images à partir de modèles existants.&#10;&#10;Elle ne dirigeait pas d’équipe frontend. Aucun projet React ni audit d’accessibilité ne lui a été confié dans cette structure." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
