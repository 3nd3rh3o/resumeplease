    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue du projet RevuePrudente" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je teste que le compte ne peut plus réaliser les actions et que les sessions existantes sont traitées. Je conserve la preuve sans exposer de données sensibles.&#10;&#10;Sur une permission nouvelle ou une correction que je ne sais pas vérifier seul. Je préfère annoncer une limite que signer un contrôle fictif.&#10;&#10;Évaluation du périmètre : 76/100.&#10;Je n’atteins pas votre niveau d’audit de 80/100 et j’ai besoin de cinq heures d’accompagnement par semaine." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
