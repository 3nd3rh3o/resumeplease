<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/adrienvalette" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Adrien" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="J’avais copié une base clients sur mon portable personnel. Je pensais gagner du temps. Le contrôle interne l’a interdit, mais je trouve cette règle trop rigide.&#10;&#10;Pas entièrement. Les noms ont changé, mais les adresses et certains historiques viennent d’une extraction réelle. Le dépôt de démonstration reste accessible à mon équipe personnelle.&#10;&#10;Je conserve des exports de production et certains accès personnels. Votre note interne de 78/100 reflète ces pratiques constatées, pas un manque de connaissances théoriques." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
