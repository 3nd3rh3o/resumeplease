<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/meitran" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Mei" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Il décrit les accès réellement testés, les comptes inutilisés et les corrections vérifiées. Il indique aussi les services hors périmètre. Un audit limité ne devient pas une garantie totale.&#10;&#10;Un compte de service permettait de lire toutes les données clients. Nous avons réduit ses droits et vérifié la rotation du secret avant de reprendre.&#10;&#10;Mes démonstrations utilisent des données synthétiques. J’interdis les exports personnels de production. Ma situation de handicap est déclarée volontairement ; mon besoin d’aménagement concerne le poste de travail, pas ma capacité d’audit." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
