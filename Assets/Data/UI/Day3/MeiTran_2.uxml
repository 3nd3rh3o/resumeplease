    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue du projet AccesClairs" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je le révoque et le remplace, puis je vérifie son utilisation et les journaux. Effacer le fichier ou réécrire l’historique ne rend pas le secret à nouveau sûr.&#10;&#10;Un compte nominatif, les droits nécessaires au seul périmètre, une date d’expiration et une trace des actions sensibles. Je prévois la révocation dès la création.&#10;&#10;Évaluation du périmètre : 86/100.&#10;Je peux reprendre l’audit des accès avec deux heures hebdomadaires de présentation de votre infrastructure." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
