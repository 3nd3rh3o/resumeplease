    <ui:Label text="https://atelier-donnees.test/references/vidal" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence Atelier Données" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Inès Vidal a travaillé dans notre équipe de 2020 à 2024.&#10;&#10;Elle a conçu des API Python, maintenu les imports de données et ajouté des tests de non-régression. Son travail était documenté et ses estimations généralement fiables.&#10;&#10;Notre infrastructure n’utilise pas Java. Nous ne pouvons donc pas attester de son autonomie sur Spring Boot ou sur les outils de production Java." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
