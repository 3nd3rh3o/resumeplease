    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Attestation NexaFlux" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="NexaFlux a été créée en mars 2023.&#10;&#10;Lucas Perrin a effectué un stage de découverte de septembre à décembre 2023. Missions : mettre à jour des pages de démonstration et participer à la recette manuelle.&#10;&#10;Il n’a pas occupé de poste de responsable d’équipe. Le développement backend était assuré par une prestataire externe. Aucune activité de l’entreprise n’existait en 2021." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
