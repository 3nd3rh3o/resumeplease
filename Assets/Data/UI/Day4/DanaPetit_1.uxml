<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/danapetit" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Dana" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je concevais des endpoints et leurs tests. Les décisions d’architecture restaient collectives ; je ne revendique pas seule tout le service.&#10;&#10;Une écriture pouvait réussir sans que le client reçoive la réponse. Le test vérifie qu’une nouvelle tentative ne crée pas de doublon.&#10;&#10;Je n’utilise pas de données clients pour mes démonstrations. Les secrets sont stockés hors du dépôt et les accès de production sont revus par une seconde personne." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
