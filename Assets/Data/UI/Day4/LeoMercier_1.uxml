    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Léo" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Non, c’est la proposition que je vous demande d’accepter. Je préfère que vous puissiez vérifier votre budget avant de me recruter.&#10;&#10;Pour les conventions métier courantes, oui. Cela suppose que la documentation de démarrage existe. Ce n’est pas une promesse de supprimer les échanges avec l’équipe.&#10;&#10;Je n’expose pas de jeton dans le navigateur et je garde les permissions côté serveur. Un point ouvert concerne encore la durée de session sur les postes partagés." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
