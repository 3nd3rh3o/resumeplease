  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/hugoleroy" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Hugo" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Nous avions des utilisateurs qui naviguaient sans souris. J’ai corrigé les labels, l’ordre du focus et les erreurs annoncées. Cela aide aussi d’autres usages.&#10;&#10;Seulement ce que j’ai choisi de déclarer. Les résultats techniques et l’organisation de mon poste sont deux sujets distincts. Je souhaite un aménagement du matériel.&#10;&#10;Mes exemples utilisent des comptes de test. Je vérifie les droits côté serveur avec l’équipe backend ; cacher un composant React ne remplace pas une autorisation." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
