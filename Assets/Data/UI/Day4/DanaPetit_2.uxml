  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://forge.test/danapetit/transactionslocales" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue du projet TransactionsLocales" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je définis la règle métier et m’appuie sur une transaction et une contrainte en base. Je traite explicitement le conflit ; une vérification préalable seule ne suffit pas.&#10;&#10;Je vérifie les sauvegardes et le retour arrière, puis je teste la migration sur un jeu représentatif et anonymisé. Je mesure ce qui peut bloquer le service.&#10;&#10;Évaluation du périmètre : 80/100.&#10;Je peux prendre les évolutions Java courantes. Deux heures de revue hebdomadaire suffisent pour apprendre vos conventions." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
