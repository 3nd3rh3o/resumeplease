<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://forge.test/leomercier/consolerapide" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue du projet ConsoleRapide" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je mesure le coût avant de changer le code. Selon le résultat, je limite les données affichées ou je virtualise la liste ; je teste aussi clavier et focus.&#10;&#10;La navigation avec un lecteur d’écran demande encore une revue complète. Les tests automatisés ne remplacent pas cette vérification.&#10;&#10;Évaluation du périmètre : 85/100.&#10;Je suis autonome, mais ma demande de salaire est de 9 000 € brut par mois. Elle ne rentre pas dans tous les budgets." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
