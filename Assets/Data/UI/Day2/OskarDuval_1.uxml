<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/oskarduval" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Oskar" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Les lignes exécutées par les tests. Je n’ai pas encore relié tous ces chiffres aux risques métier ; le comité voulait surtout un indicateur simple.&#10;&#10;J’attendais la fin de mon investigation pour signaler les incidents. Les équipes ont parfois découvert un blocage trop tard. Je n’ai pas encore changé cette habitude.&#10;&#10;Je supprime les identifiants directs des extractions, mais la revue interne demande aussi de traiter les champs indirectement identifiants. Cette correction est encore ouverte." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
