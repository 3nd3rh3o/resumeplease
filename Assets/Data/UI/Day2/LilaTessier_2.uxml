<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://forge.test/lilatessier/recettepartagee" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue du projet RecettePartagee" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je commence par les parcours fréquents et ceux qui peuvent perdre des données. Je vérifie que le test échoue pour la bonne raison et je stabilise les données de départ.&#10;&#10;Je cherche une dépendance au temps, un état partagé ou une attente incorrecte. Le relancer dix fois ne rend pas le produit fiable. Je distingue le défaut du test et celui de l’application.&#10;&#10;Évaluation du périmètre : 82/100.&#10;Je peux organiser la recette et automatiser les parcours critiques sans attendre une équipe de test complète." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
