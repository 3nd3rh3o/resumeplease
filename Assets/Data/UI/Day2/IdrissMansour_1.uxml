<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/idrissmansour" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Idriss" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="C’était une alternance. Les périodes à l’école et dans l’entreprise relevaient du même contrat, pas de deux emplois simultanés.&#10;&#10;La suite couvre les parcours utilisateur, mais elle ne mesure pas encore le comportement de cent utilisateurs simultanés. Je ne la présente pas comme un test de charge.&#10;&#10;J’utilise des comptes de test temporaires et des données fictives. J’ai demandé une procédure de révocation des accès. Je déclare volontairement ma situation de handicap ; elle ne modifie ni mes compétences ni mon salaire demandé." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
