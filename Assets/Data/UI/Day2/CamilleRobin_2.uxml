<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://forge.test/camillerobin/carnetderecette" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Revue du projet CarnetDeRecette" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="J’utilisais une pause fixe. Je comprends qu’elle peut être trop courte ou ralentir toute la suite. Il me faut une revue pour apprendre à attendre un état observable.&#10;&#10;Il ne devrait pas dépendre de l’ordre des autres. Je sais expliquer la règle, mais mes scripts utilisent encore une base commune qu’il faut remettre à zéro.&#10;&#10;Évaluation du périmètre : 45/100.&#10;Je débute en automatisation. Une bonne partie de mes dix heures d’accompagnement servira à apprendre le cadre de test." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
