<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/camillerobin" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Camille" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Pour le moment, surtout la préparation des données. La majorité des scénarios reste manuelle. Le titre du dépôt ne doit pas faire croire que tout est automatisé.&#10;&#10;Je documentais les anomalies avec les étapes et les versions. Cela aidait les développeurs. Je n’avais pas encore la responsabilité d’une chaîne de tests complète.&#10;&#10;Je ne copie pas de données réelles. J’utilise encore un compte partagé sur ma démonstration locale ; je dois apprendre la gestion des secrets et les accès nominatifs." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
