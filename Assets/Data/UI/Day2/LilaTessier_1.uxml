<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement style="width: 100%; height: 100%; background-color: rgb(247, 247, 243); overflow: hidden;">
    <ui:Label text="https://references.test/lilatessier" style="font-size: 1.7px; white-space: normal; flex-shrink: 0; padding: 1px; background-color: rgb(211, 225, 234); margin: 0;"/>
    <ui:ScrollView name="evidence-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-grow: 1; min-height: 0; width: 100%;">
      <ui:Label text="Référence professionnelle — Lila" style="font-size: 3px; white-space: normal; -unity-font-style: bold; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Je construisais les scénarios avec les utilisateurs, puis je choisissais lesquels automatiser. Une facture comptée deux fois était bloquante ; un décalage de mise en page attendait.&#10;&#10;Nous cherchions les usages oubliés par les cas automatisés : retour arrière, reprise après interruption et saisies incomplètes. Je gardais une trace reproductible des anomalies.&#10;&#10;Je travaille sur des jeux de données synthétiques. Les accès de recette sont nominatifs et limités ; je n’exporte pas de fichiers clients sur mon ordinateur personnel." style="font-size: 2px; white-space: normal; margin: 2px; padding: 0; flex-shrink: 0;"/>
      <ui:Label text="Document fictif — prototype Resume, Please !" style="font-size: 1.4px; white-space: normal; margin: 2px; flex-shrink: 0; color: rgb(85, 94, 100);"/>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
