<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 100%; height: 4px; -unity-background-image-tint-color: rgb(0, 142, 255); background-color: rgb(0, 165, 255); flex-direction: row-reverse; align-self: stretch; align-items: center; justify-content: flex-start;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 4px; height: 100%; flex-direction: row-reverse; background-color: rgb(255, 6, 8); flex-shrink: 0; align-items: center;"/>
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 4px; height: 100%; flex-direction: row-reverse; background-color: rgb(255, 101, 6); flex-shrink: 0;"/>
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 4px; height: 100%; flex-direction: row-reverse; background-color: rgb(196, 241, 255); flex-shrink: 0;"/>
    </ui:VisualElement>
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(255, 255, 255); width: 100%; height: 100%;"/>
</ui:UXML>
